{
  "version": 3,
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang.exe",
        "CMAKE_CXX_COMPILER": "clang++.exe",
        "CMAKE_C_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_C_EXTENSIONS": "OFF",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "BUILD_SHARED_LIBS": "OFF",
        "TINYPBRT_INSTALL_TEST": "OFF",
        "TINYPBRT_BUILD_TESTS": "ON",
        "TINYPBRT_BUILD_BENCHMARK": "ON",
        "TINYPBRT_BUILD_COVERAGE": "ON",
        "TINYPBRT_BUILD_DOCUMENTATION": "ON",
        "TINYPBRT_BUILD_EXAMPLES": "ON",
        "TINYPBRT_ENABLE_CLANG_TIDY": "ON"
      }
    },
    {
      "name": "windows-base",
      "description": "System Windows ze środowiskiem programistycznym programu Visual Studio jako element docelowy.",
      "inherits": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "installDir": "${sourceDir}/install/${presetName}",
	  "vendor": {
		"microsoft.com/VisualStudioSettings/CMake/1.0": {
		  "enableMicrosoftCodeAnalysis": false,
		  "enableClangTidyCodeAnalysis": true
		}
	  },
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "c11",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_STANDARD": "11"
      }
    },
    {
      "name": "debug",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "x64",
      "hidden": true,
	  "vendor": {
		"microsoft.com/VisualStudioSettings/CMake/1.0": {
			"intelliSenseMode": "windows-clang-x64"
		}
	},
      "architecture": {
        "value": "x64",
        "strategy": "external"
      }
    },
    {
      "name": "x86",
      "hidden": true,
	  "vendor": {
		"microsoft.com/VisualStudioSettings/CMake/1.0": {
			"intelliSenseMode": "windows-clang-x86"
		}
	},
      "architecture": {
        "value": "x86",
        "strategy": "external"
      }
    },
    {
      "name": "x64-debug-c11",
      "displayName": "x64 Debug C11",
      "description": "Docelowy system Windows (64-bitowy). (Debug)",
      "inherits": ["windows-base", "c11", "x64", "debug"]
    },
    {
      "name": "x64-release-c11",
      "displayName": "x64 Release C11",
      "description": "Docelowy system Windows (64-bitowy). (RelWithDebInfo)",
      "inherits": ["release", "x64-debug-c11"]
    },
    {
      "name": "x86-debug-c11",
      "displayName": "x86 Debug C11",
      "description": "Docelowy system Windows (32-bitowy). (Debug)",
      "inherits": ["windows-base", "x86", "c11", "debug"]
    },
    {
      "name": "x86-release-c11",
      "displayName": "x86 Release C11",
      "description": "Docelowy systemu Windows (32-bitowy). (RelWithDebInfo)",
      "inherits": ["release", "x86-debug-c11"]
    },
    {
      "name": "sanitizers",
      "hidden": true,
      "cacheVariables": {
        "TINYPBRT_ENABLE_SANITIZERS": "ON",
        "TINYPBRT_SANITIZERS": "address;undefined",
        "TINYPBRT_BUILD_COVERAGE": "OFF",
        "TINYPBRT_BUILD_BENCHMARK": "OFF"
      }
    },
    {
      "name": "x64-debug-c11-sanitizers",
      "displayName": "x64 Debug C11 + ASan/UBSan",
      "description": "Docelowy system Windows (64-bitowy). (Debug, AddressSanitizer + UndefinedBehaviorSanitizer)",
      "inherits": ["sanitizers", "x64-debug-c11"]
    },
    {
      "name": "linux-base",
      "hidden": true,
      "inherits": "base",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang",
        "CMAKE_CXX_COMPILER": "clang++",
        "TINYPBRT_BUILD_DOCUMENTATION": "OFF",
        "TINYPBRT_BUILD_EXAMPLES": "OFF",
        "TINYPBRT_ENABLE_CLANG_TIDY": "OFF"
      },
      "condition": {
        "type": "notEquals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      }
    },
    {
      "name": "linux-debug-sanitizers",
      "displayName": "Linux/macOS Debug + ASan/UBSan/LSan",
      "inherits": ["sanitizers", "linux-base", "c11", "debug"]
    }
  ],
  "testPresets": [
    {
      "name": "x64-debug-c11-sanitizers",
      "configurePreset": "x64-debug-c11-sanitizers",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-debug-sanitizers",
      "configurePreset": "linux-debug-sanitizers",
      "output": { "outputOnFailure": true }
    }
  ]
}
